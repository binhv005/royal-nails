# Copy to .env.local and fill in. Never commit real secrets.

# Endpoint that receives appointment requests (POST JSON), e.g. https://api.example.com/api/appointment-requests
# Leave empty until a backend or approved form service is connected — the form will
# then tell visitors it is not accepting online requests yet.
VITE_APPOINTMENT_API_URL=

# Set to "true" only after a Google tag / GTM container and a consent flow are configured.
VITE_ENABLE_TRACKING=false
